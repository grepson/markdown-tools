  "description": "TypeScript-based Pandoc file orchestrator with Docker support",
  "main": "dist/orchestrator.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/orchestrator.js",
    "dev": "tsx orchestrator.ts",
    "watch": "tsc --watch"
  },
